# Database (Railway/Render/Supabase all give you this connection string)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Server
PORT=3000
NODE_ENV=development

# Private key shared only with the Shopify app server (generate a long random value)
DASHBOARD_API_KEY=replace_with_a_long_random_secret
# Optional comma-separated browser origins. Server-to-server app requests do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shopify (Settings -> Notifications -> Webhooks -> shows a signing secret when you save)
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
SHOPIFY_STORE_DOMAIN=g892i7-7c.myshopify.com

# SPX OpenAPI. Use the UAT credentials supplied by SPX support while testing.
# Set SPX_MODE=api only after every required value below is configured.
SPX_MODE=disabled
SPX_ENVIRONMENT=uat
SPX_API_BASE_URL=https://test-stable.spx.ph
SPX_APP_ID=your_spx_app_id
SPX_APP_SECRET=your_spx_app_secret
SPX_USER_ID=your_spx_user_id
SPX_USER_SECRET=your_spx_user_secret
SPX_API_TIMEOUT_MS=20000

# Public tracking callback registered by SPX. Overrides are optional and are
# useful while live credentials are being activated; otherwise SPX_APP_* apply.
SPX_WEBHOOK_APP_ID=
SPX_WEBHOOK_APP_SECRET=
SPX_WEBHOOK_MAX_AGE_SECONDS=600

# Production sender is the Ninja Van fulfillment warehouse. Confirm the exact
# SPX address-hierarchy labels with SPX before switching to production.
SPX_SENDER_NAME=Ninjavan Fulfillment Warehouse
SPX_SENDER_PHONE=+639203588780
SPX_SENDER_STATE=South Luzon
SPX_SENDER_CITY=Laguna
SPX_SENDER_DISTRICT=Cabuyao City
SPX_SENDER_STREET=Pulo
SPX_SENDER_POST_CODE=4025
SPX_SENDER_DETAIL_ADDRESS=WH 5&6 National Highway Brgy Pulo Cabuyao Laguna 4025 (behind Grandshoppe Center)

# UAT must use only the approved Amsic sender from SPX's test guide.
SPX_UAT_SENDER_NAME=B&B BEAU+ UAT
SPX_UAT_SENDER_PHONE=replace_with_spx_uat_sender_phone
SPX_UAT_SENDER_POST_CODE=replace_with_spx_uat_sender_post_code
SPX_UAT_SENDER_DETAIL_ADDRESS=Amsic

# UAT never sends a real customer address or phone. The approved receiver
# profile is Visayas/Eastern Samar/Oras/Agsam; only these test values are needed.
SPX_UAT_RECEIVER_NAME=SPX UAT Receiver
SPX_UAT_RECEIVER_PHONE=09170000000
SPX_UAT_RECEIVER_POST_CODE=replace_with_spx_confirmed_post_code
SPX_UAT_RECEIVER_DETAIL_ADDRESS=Agsam

# UAT defaults to drop-off. For live pickup, the backend calls SPX API 1.1 and
# uses the earliest returned timeslot automatically. Set all three values below
# only when an operator needs to override that automatic selection temporarily.
SPX_COLLECT_TYPE=2
SPX_PICKUP_TIME=
SPX_PICKUP_TIME_RANGE_ID=
SPX_PICKUP_TIME_RANGE=

# Defaults used to populate SPX's official mass-order Excel template
# Leave the weight override blank so the app calculates 188 g per physical box.
SPX_UNIT_BOX_WEIGHT_G=188
SPX_PARCEL_WEIGHT_KG=
# Temporary test dimensions; replace with measured packed-parcel dimensions.
SPX_PARCEL_LENGTH_CM=20
SPX_PARCEL_WIDTH_CM=15
SPX_PARCEL_HEIGHT_CM=10
SPX_ITEM_TYPE=Food and beverage
SPX_PAYMENT_METHOD=Sender Pay
SPX_DELIVERY_INSTRUCTION=
SPX_PARCEL_INSURED_VALUE=

# SellerCraft imports Shopify orders into Anchanto. Use manual mode while Ninja
# Van confirms packed status and AWB receipt outside a direct Anchanto API.
OMS_MODE=manual
OMS_API_BASE_URL=
OMS_API_TOKEN=
OMS_CREATE_ORDER_PATH=/orders
OMS_ORDER_STATUS_PATH=/orders/{order_id}
OMS_AWB_PATH=/orders/{order_id}/awb

# Automatic SPX AWB archive and Ninja Van monitoring sheet.
# Create a service account, enable Google Drive + Sheets APIs, and add the
# service-account email as a member of the Shared Drive/folder and spreadsheet.
# For Render, base64-encode the complete downloaded service-account JSON into
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64. The email/key pair is an alternative.
GOOGLE_AWB_MODE=disabled
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=AWB Monitoring

# Customer messaging remains with Shopify unless this is deliberately enabled.
CUSTOMER_SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_NAME=b&bBeauPlus
